{
  "expo": {
    "name": "SmartAttendance-Mobile",
    "slug": "SmartAttendance-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartattendancemobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartattendance.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Votre position permet de valider votre site de pointage et de détecter le réseau Wi-Fi.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "package": "com.smartattendance.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F22",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F22",
          "dark": {
            "backgroundColor": "#0B0F22"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Utilisez Face ID pour vous reconnecter rapidement à SmartAttendance."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Accédez à la caméra pour pointer par reconnaissance faciale."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Votre position permet de valider votre site de pointage."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Accédez à la galerie pour choisir une photo de référence."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4de86be5-42b5-4c7c-9b2f-3491c4dfd02c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4de86be5-42b5-4c7c-9b2f-3491c4dfd02c"
    }
  }
}
